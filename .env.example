# ---------------------------------------------------------------
# All variables are optional. Copy to .env and adjust as needed.
# ---------------------------------------------------------------

# Port on the host (docker compose only)
PORT=3000

# Public URL – used for sitemap/robots. Detected automatically if empty.
SITE_URL=

# Language and time zone for the factory defaults (first start only)
DEFAULT_LOCALE=de
DEFAULT_TIMEZONE=Europe/Berlin

# --- Setup / owner account -------------------------------------
# Option A (recommended): open /setup in the browser after the first start.
# Option B: create the owner automatically on first start:
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Protect the /setup page with a token until the owner exists:
SETUP_TOKEN=

# --- Security ---------------------------------------------------
# Secure cookies: auto-detected via X-Forwarded-Proto. Force with true/false.
COOKIE_SECURE=
# Random string – salts the daily visitor hashes of the statistics.
STATS_SALT=change-me
# Allow RSS feeds from private networks (homelab). Default: blocked (SSRF protection).
ALLOW_PRIVATE_FETCH=false

# --- Storage ----------------------------------------------------
# Docker: data lives in /data (volume). Local dev: ./data
DATA_DIR=
# Max upload size in MB
MEDIA_MAX_MB=25

# --- Vercel / serverless only ----------------------------------
# A libSQL database (e.g. Turso). Leave empty for the local SQLite file.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
